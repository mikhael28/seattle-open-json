{
    "name": "seattle-open-json",
    "version": "1.4.0",
    "description": "An open collection of JSON data about the branches of government and services provided by the City of Seattle, and other government entities and civil society organizations in the Puget Sound Region.",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "sideEffects": false,
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "require": "./dist/index.js",
            "types": "./dist/index.d.ts"
        },
        "./types": {
            "import": "./dist/scs-model.js",
            "require": "./dist/scs-model.js",
            "types": "./dist/scs-model.d.ts"
        },
        "./community-centers": {
            "import": "./dist/data/community-centers.js",
            "require": "./dist/data/community-centers.js",
            "types": "./dist/data/community-centers.d.ts"
        },
        "./farmers-markets": {
            "import": "./dist/data/farmers-markets.js",
            "require": "./dist/data/farmers-markets.js",
            "types": "./dist/data/farmers-markets.d.ts"
        },
        "./parks-catalog": {
            "import": "./dist/data/parks-catalog.js",
            "require": "./dist/data/parks-catalog.js",
            "types": "./dist/data/parks-catalog.d.ts"
        },
        "./mobile-recreation": {
            "import": "./dist/data/mobile-recreation-programming.js",
            "require": "./dist/data/mobile-recreation-programming.js",
            "types": "./dist/data/mobile-recreation-programming.d.ts"
        },
        "./p-patch": {
            "import": "./dist/data/p-patch.js",
            "require": "./dist/data/p-patch.js",
            "types": "./dist/data/p-patch.d.ts"
        },
        "./picnic-sites": {
            "import": "./dist/data/picnic-sites.js",
            "require": "./dist/data/picnic-sites.js",
            "types": "./dist/data/picnic-sites.d.ts"
        },
        "./public-spaces": {
            "import": "./dist/data/privately-owned-public-spaces.js",
            "require": "./dist/data/privately-owned-public-spaces.js",
            "types": "./dist/data/privately-owned-public-spaces.d.ts"
        },
        "./youth-programs": {
            "import": "./dist/data/youth-programs.js",
            "require": "./dist/data/youth-programs.js",
            "types": "./dist/data/youth-programs.d.ts"
        },
        "./resource-guide": {
            "import": "./dist/data/emerald-city-resource-guide.js",
            "require": "./dist/data/emerald-city-resource-guide.js",
            "types": "./dist/data/emerald-city-resource-guide.d.ts"
        },
        "./building-permits": {
            "import": "./dist/data/building-permits.js",
            "require": "./dist/data/building-permits.js",
            "types": "./dist/data/building-permits.d.ts"
        },
        "./plan-comments": {
            "import": "./dist/data/plan-comments.js",
            "require": "./dist/data/plan-comments.js",
            "types": "./dist/data/plan-comments.d.ts"
        },
        "./plan-review": {
            "import": "./dist/data/plan-review.js",
            "require": "./dist/data/plan-review.js",
            "types": "./dist/data/plan-review.d.ts"
        },
        "./customer-support": {
            "import": "./dist/data/customer-support.js",
            "require": "./dist/data/customer-support.js",
            "types": "./dist/data/customer-support.d.ts"
        },
        "./customer-support-types": {
            "import": "./dist/data/customer-support-types.js",
            "require": "./dist/data/customer-support-types.js",
            "types": "./dist/data/customer-support-types.d.ts"
        },
        "./migrations": {
            "import": "./dist/migrations/index.js",
            "require": "./dist/migrations/index.js",
            "types": "./dist/migrations/index.d.ts"
        },
        "./migrations/*": {
            "import": "./dist/migrations/*.js",
            "require": "./dist/migrations/*.js",
            "types": "./dist/migrations/*.d.ts"
        },
        "./scs": {
            "import": "./dist/scs-loader.js",
            "require": "./dist/scs-loader.js",
            "types": "./dist/scs-loader.d.ts"
        }
    },
    "files": [
        "dist/**/*",
        "src/**/*",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "tsc",
        "build:watch": "tsc --watch",
        "prepublishOnly": "npm run build",
        "scrape": "node scrape-organizations.js",
        "convert": "node scripts/markdown-to-json.js",
        "convert:single": "node scripts/markdown-to-json.js --single",
        "consolidate": "node scripts/consolidate-programs.js",
        "consolidate:pretty": "node scripts/consolidate-programs.js --pretty",
        "generate:scs": "tsx scripts/generate-scs-data.ts",
        "test": "echo \"Error: no test specified\" && exit 1"
    },
    "type": "module",
    "keywords": [
        "scraper",
        "seattle",
        "youth"
    ],
    "author": "Michael Nightingale",
    "license": "MIT",
    "dependencies": {},
    "devDependencies": {
        "typescript": "^5.0.0",
        "tsx": "^4.7.0",
        "@types/node": "^20.0.0"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/mikhael28/seattle-open-json"
    }
}